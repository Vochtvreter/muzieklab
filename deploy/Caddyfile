# Muzieklab on Caddy (docs/DEPLOY.md). Caddy gets and renews the HTTPS certificates on its own.
# Copy this to /etc/caddy/Caddyfile and run: sudo systemctl reload caddy

# What production and the test site share: compression, files, and the headers.
(muzieklab) {
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Files in assets/ have a content hash in their name, so they never change: cache them for a year. Only the ones
	# that are there: the header is set before file_server answers, so a name that is missing (asked for during a
	# deploy, or one a rollback brings back) would keep its 404 for a year too.
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html, the service worker, the manifest, icons, a missing file) is checked on each visit, so
	# an update shows.
	@other {
		not {
			path /assets/*
			file
		}
	}
	header @other Cache-Control "no-cache"

	header /manifest.webmanifest Content-Type application/manifest+json
}

# Production: deploys from main. The deploy workflow points current at the newest release.
vivanova.app {
	# The API (muzieklab-api@production, docs/DEPLOY.md: Production's API); it sets its own headers. Until that
	# service runs, /api/* answers 502, and the app shows no Account section, as on a site without an API.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /var/www/muzieklab/current
		import muzieklab
	}
}

www.vivanova.app {
	redir https://vivanova.app{uri} permanent
}

# The test site: deploys from the test branch, or any branch by hand. Kept out of search engines.
test.vivanova.app {
	header X-Robots-Tag "noindex, nofollow"

	# The API (muzieklab-api@test); it sets its own headers.
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /var/www/muzieklab-test/current
		import muzieklab
	}
}
