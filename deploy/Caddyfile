# Muzieklab on Caddy (docs/DEPLOY.md). Caddy gets and renews the HTTPS certificates on its own.
# Copy this to /etc/caddy/Caddyfile and run: sudo systemctl reload caddy

# What production and the test site share: compression, files, and the headers.
(muzieklab) {
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Files in assets/ have a content hash in their name, so they never change: cache them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html, the service worker, the manifest, icons) is checked on each visit, so an update shows.
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	header /manifest.webmanifest Content-Type application/manifest+json
}

# Production: deploys from main. The deploy workflow points current at the newest release.
vivanova.app {
	root * /var/www/muzieklab/current
	import muzieklab
}

www.vivanova.app {
	redir https://vivanova.app{uri} permanent
}

# The test site: deploys from the test branch, or any branch by hand. Kept out of search engines.
test.vivanova.app {
	header X-Robots-Tag "noindex, nofollow"

	# The API (muzieklab-api@test); it sets its own headers.
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /var/www/muzieklab-test/current
		import muzieklab
	}
}
