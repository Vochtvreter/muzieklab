# Muzieklab on Caddy (docs/DEPLOY.md). Caddy gets and renews the HTTPS certificate on its own.
# Copy this to /etc/caddy/Caddyfile and run: sudo systemctl reload caddy
vivanova.app {
	# The deploy workflow points current at the newest release.
	root * /var/www/muzieklab/current
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Files in assets/ have a content hash in their name, so they never change: cache them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html, the service worker, the manifest, icons) is checked on each visit, so an update shows.
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	header /manifest.webmanifest Content-Type application/manifest+json
}
